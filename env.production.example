# Aroma ERP Production Environment Configuration

APP_NAME="Aroma ERP System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=aroma_erp
DB_USERNAME=aroma_user
DB_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-server.com
MAIL_PORT=587
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache Configuration
CACHE_DRIVER=redis
CACHE_PREFIX=aroma_erp

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Broadcasting Configuration
BROADCAST_DRIVER=log

# File Storage Configuration
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mobile API Configuration
MOBILE_PUSH_ENABLED=true
FCM_SERVER_KEY=your_fcm_server_key
FCM_SENDER_ID=your_fcm_sender_id
MOBILE_OFFLINE_SYNC=true
MOBILE_MAX_SYNC_ITEMS=100
MOBILE_SYNC_INTERVAL=300
MOBILE_API_RATE_LIMIT=100
MOBILE_API_TIMEOUT=30
MOBILE_API_VERSION=1.0.0
MOBILE_TOKEN_EXPIRY=30
MOBILE_REFRESH_TOKEN_EXPIRY=90
MOBILE_MAX_DEVICES=3

# Security Configuration
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,your-domain.com
SESSION_DOMAIN=your-domain.com
SANCTUM_GUARD=web

# Performance Configuration
OPCACHE_ENABLE=true
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_MAX_ACCELERATED_FILES=4000

# Monitoring Configuration
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backup Configuration
BACKUP_DISK=local
BACKUP_NOTIFICATION_MAIL=admin@your-domain.com

# SSL Configuration
FORCE_HTTPS=true
SECURE_COOKIES=true
